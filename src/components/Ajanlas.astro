---
import type { T } from '../i18n/v3/hu';
import { SHOP_URL } from '../i18n/v3/shop-link';
const { tr } = Astro.props as { tr: T };
const sh = tr.shop;
---

<div class="ajanlas-brush-wrap">
  <svg class="brush" viewBox="0 0 200 10" preserveAspectRatio="none" aria-hidden="true">
    <path d="M1,2.6 L199,4.2 L199,5.6 L1,7.4 Z" fill="url(#brushgrad)"/>
  </svg>
</div>

<section class="ajanlas">
  <div class="ajanlas-inner">
    <div class="ajanlas-text">
      <span class="eyebrow">{sh.eyebrow}</span>
      <h2 class="ajanlas-h2">{sh.h2}</h2>
      <p class="ajanlas-body">{sh.body}</p>
    </div>
    <div class="btn-wrap">
      <a href={SHOP_URL} class="btn-cut" target="_blank" rel="noopener noreferrer sponsored">
        <span class="lbl">{sh.cta}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>
    </div>
  </div>
</section>

<div class="ajanlas-brush-wrap">
  <svg class="brush" viewBox="0 0 200 10" preserveAspectRatio="none" aria-hidden="true">
    <path d="M1,2.6 L199,4.2 L199,5.6 L1,7.4 Z" fill="url(#brushgrad)"/>
  </svg>
</div>

<style>
  .ajanlas-brush-wrap{max-width:1000px;margin:0 auto;padding:0 var(--page-margin);}
  .ajanlas-brush-wrap .brush{margin:1.6rem 0;}
  .ajanlas{background:var(--bg);padding:1.3rem var(--page-margin) 1.3rem;}
  .ajanlas-inner{max-width:1000px;margin:0 auto;display:flex;flex-direction:column;gap:1.2rem;}
  .ajanlas-h2{font-family:var(--serif);font-weight:400;font-size:var(--section-h2);line-height:1.1;color:var(--ink);margin:0 0 .6rem;}
  .ajanlas-body{font-family:var(--sans);font-size:var(--section-body);font-weight:300;color:var(--muted);line-height:1.6;margin:0;max-width:480px;}
  .btn-wrap{margin-top:.2rem;}
  .btn-cut{display:inline-flex;padding:0;background:conic-gradient(from 200deg at 50% 50%,rgba(168,201,106,0.12) 0%,rgba(168,201,106,0.5) 20%,#A8C96A 40%,#8FAE52 50%,#A8C96A 60%,rgba(168,201,106,0.4) 80%,rgba(168,201,106,0.12) 100%);clip-path:polygon(9px 0,100% 0,100% calc(100% - 9px),calc(100% - 9px) 100%,0 100%,0 9px);border:none;cursor:pointer;transition:.3s;text-decoration:none;}
  .btn-cut .lbl{display:inline-flex;align-items:center;gap:.45rem;white-space:nowrap;margin:1.5px;background:var(--bg);clip-path:polygon(8px 0,100% 0,100% calc(100% - 8px),calc(100% - 8px) 100%,0 100%,0 8px);color:var(--ink);font-family:var(--sans);font-size:.6rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:.75rem .95rem;transition:.3s;}
  .btn-cut:hover .lbl{background:var(--green);color:#fff;}
  @media (min-width:760px){
    .ajanlas-inner{flex-direction:row;align-items:center;justify-content:space-between;gap:3rem;}
    .ajanlas-body{max-width:520px;}
  }
</style>

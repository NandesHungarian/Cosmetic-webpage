---
import type { T } from '../i18n/v3/hu';
import { SHOP_URL } from '../i18n/v3/shop-link';
const { tr } = Astro.props as { tr: T };
const sh = tr.shop;
---

<section class="ajanlas">
  <div class="ajanlas-inner">
    <div class="ajanlas-text">
      <span class="eyebrow">{sh.eyebrow}</span>
      <h3 class="ajanlas-h3">{sh.h2}</h3>
      <p class="ajanlas-body">{sh.body}</p>
    </div>
    <a href={SHOP_URL} class="ajanlas-btn" target="_blank" rel="noopener noreferrer sponsored">
      {sh.cta}
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</section>

<style>
  .ajanlas{background:var(--bg);padding:0 var(--page-margin) 2.5rem;}
  .ajanlas-inner{max-width:1000px;margin:0 auto;background:var(--box);border:1px solid var(--line);border-radius:14px;padding:1.5rem 1.6rem;display:flex;flex-direction:column;gap:1.1rem;}
  .ajanlas .eyebrow{margin-bottom:.5rem;}
  .ajanlas-h3{font-family:var(--serif);font-weight:400;font-size:1.05rem;line-height:1.2;color:var(--ink);margin:0 0 .5rem;}
  .ajanlas-body{font-family:var(--sans);font-size:var(--section-body);font-weight:300;color:var(--muted);line-height:1.6;margin:0;max-width:560px;}
  .ajanlas-btn{align-self:flex-start;flex-shrink:0;display:inline-flex;align-items:center;gap:.4rem;white-space:nowrap;background:transparent;border:1.5px solid var(--green);color:var(--green-deep);text-decoration:none;padding:.6rem .95rem;border-radius:8px;font-family:var(--sans);font-size:.65rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;transition:background .2s,color .2s;}
  .ajanlas-btn:hover{background:var(--green);color:#fff;}
  @media (min-width:760px){
    .ajanlas-inner{flex-direction:row;align-items:center;justify-content:space-between;gap:2.5rem;padding:1.6rem 2rem;}
    .ajanlas-btn{align-self:center;}
  }
</style>
